// The connection URL lives in prisma.config.ts (CLI) and src/lib/db.ts (runtime).
datasource db {
  provider = "sqlite"
}

// Generated into src/ so tsc compiles it into dist/ with the rest of the bot.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// One RaidTeam = one Discord role whose members are assumed required for
// every raid instance generated from its slots. The team's schedule lives
// in a single persistent message in one channel, edited in place as raids
// come and go rather than posting a new message per raid.
model RaidTeam {
  id        String   @id @default(cuid())
  guildId   String
  roleId    String
  channelId String
  timezone  String
  name      String?
  createdAt DateTime @default(now())

  // The one persistent, non-scrolling schedule message for this team.
  messageId String?
  // How many raids the public message lists under Coming Up, after the Next Up
  // raid (the `coming-up` option, default 3). Personal scrolling happens only
  // through /schedule, which is ephemeral and never affects this message.
  displayCount Int @default(3)

  slots     RaidSlot[]
  instances RaidInstance[]

  @@unique([guildId, roleId])
}

// A weekly recurring raid time, e.g. "Tuesday 20:00". dayOfWeek follows
// Luxon's convention: 1 = Monday ... 7 = Sunday.
model RaidSlot {
  id         String @id @default(cuid())
  raidTeamId String
  dayOfWeek  Int
  hour       Int
  minute     Int

  raidTeam RaidTeam @relation(fields: [raidTeamId], references: [id], onDelete: Cascade)

  @@unique([raidTeamId, dayOfWeek, hour, minute])
}

// A concrete occurrence of a raid, generated ahead of time from a team's
// slots. Attendance defaults to "required" (IN) for every member holding
// the team's role — an Attendance row only exists for explicit overrides.
// closed flips to true a few hours after startsAt, after which it's
// read-only and only shows up in the team's history view.
model RaidInstance {
  id         String   @id @default(cuid())
  raidTeamId String
  startsAt   DateTime
  closed     Boolean  @default(false)
  // Cancelled raids are hidden from the schedule and reject call-outs. Kept
  // rather than deleted so the hourly sync doesn't regenerate them.
  cancelled  Boolean  @default(false)
  // Added with /raidlead raid add rather than generated from a weekly night.
  // Only these can be removed outright, since the sync never regenerates them.
  oneOff     Boolean  @default(false)

  raidTeam   RaidTeam     @relation(fields: [raidTeamId], references: [id], onDelete: Cascade)
  attendance Attendance[]

  @@unique([raidTeamId, startsAt])
}

model Attendance {
  id             String   @id @default(cuid())
  raidInstanceId String
  userId         String
  status         String // "IN" | "OUT"
  updatedAt      DateTime @updatedAt

  raidInstance RaidInstance @relation(fields: [raidInstanceId], references: [id], onDelete: Cascade)

  @@unique([raidInstanceId, userId])
}
