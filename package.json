{
  "name": "ready-check",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot for WoW raid scheduling and one-click attendance call-outs.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx src/check-staging.ts && tsx watch src/index.ts",
    "check-staging": "tsx src/check-staging.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "deploy-emojis": "tsx src/deploy-emojis.ts",
    "clear-global-commands": "tsx src/clear-global-commands.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.16.3",
    "dotenv": "^18.0.5",
    "luxon": "^3.5.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^26.6.4",
    "tsx": "^4.19.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
