{
  "name": "ready-check",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/workspaces/.claude-state"
  },
  "postCreateCommand": "sh .devcontainer/persist-claude.sh && npm install && npm install -g @anthropic-ai/claude-code",
  "customizations": {
    "vscode": {
      "extensions": [
        "Prisma.prisma",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
