# Discord Developer Portal → your application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: set during local/dev testing to register slash commands to a
# single guild (instant update). Leave unset in production to register
# commands globally (takes up to ~1 hour to propagate, but works across
# every server the bot is in).
DISCORD_GUILD_ID=

# SQLite file path. Prisma expects a "file:" URL. Note: for SQLite, Prisma
# resolves a relative path against prisma/schema.prisma's own folder, not
# the repo root — so this ends up at prisma/dev.db, not prisma/prisma/dev.db.
DATABASE_URL="file:./dev.db"
