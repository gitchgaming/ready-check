# Discord Developer Portal → your application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: set during local/dev testing to register slash commands to a
# single guild (instant update). Leave unset in production to register
# commands globally (takes up to ~1 hour to propagate, but works across
# every server the bot is in).
DISCORD_GUILD_ID=

# SQLite file path as a "file:" URL. A relative path resolves from the repo
# root (where the bot and the Prisma CLI run), so this is prisma/dev.db.
DATABASE_URL="file:./prisma/dev.db"

# Optional: a Railway project token for the staging environment. `npm run dev`
# uses it to refuse to start while staging (which runs this same bot token)
# is up; without it, the check only warns. `deploy:branch`, `deploy:staging`
# and `stop-staging` need it.
RAILWAY_STAGING_TOKEN=
# Optional: staging's Railway service name, if it isn't "ready-check".
STAGING_SERVICE=

# Optional, production only: a Railway bucket the bot backs its database up to
# (docs/releasing.md → Automatic backups). Backups are off unless the first
# four are set; BACKUP_REGION defaults to "auto", BACKUP_PREFIX to "prod".
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_REGION=
BACKUP_PREFIX=
